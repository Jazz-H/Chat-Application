rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared validation for a chat message create. A message must have either
    // non-empty text (<= 500 chars) or an image URL.
    function isValidMessage() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly(
             ['text', 'name', 'uid', 'timestamp', 'imageUrl']
           )
        && (
             request.resource.data.text.size() > 0
             || (request.resource.data.imageUrl is string
                 && request.resource.data.imageUrl.size() > 0
                 && request.resource.data.imageUrl.size() < 1000000)
           );
    }

    // Guests arrive via the "Continue as Guest" button (signInAnonymously).
    // They are real authenticated users as far as `request.auth` is concerned,
    // so anything gated only on `request.auth != null` is open to the whole
    // internet. Guests may READ the public rooms — that is the point of the
    // demo — but may not write to them. Signing in with Google or email lifts
    // the restriction.
    function isGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Messages live under a room/channel:
    // rooms/{roomId}/messages/{messageId}
    // Readable by any signed-in user, guests included. Writes require a
    // non-guest account: created only by their author, edited only by their
    // author, and otherwise limited to the `reactions` field.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if isValidMessage() && !isGuest();

      // Reactions: any non-guest signed-in user may change ONLY `reactions`.
      // Edit: the author may change ONLY `text` (+ `editedAt`), within limits.
      allow update: if request.auth != null && !isGuest() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions'])
        || (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
        )
      );

      // Delete: author only.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Ephemeral "typing" indicators: one doc per user, written only by that
    // user, readable by anyone signed in. Staleness is handled client-side.
    // Guests cannot post, so they do not announce typing either.
    match /rooms/{roomId}/typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && !isGuest()
                   && request.auth.uid == userId;
    }

    // Direct-message conversations between two users. Membership is recorded
    // on the conversation doc and checked for the nested messages/typing.
    // No guest check here: these are already gated on mutual membership, so a
    // guest can only write where another user has deliberately included them.
    match /conversations/{convId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.members;
      }

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && isValidMessage();
        allow update: if isMember() && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions'])
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
          )
        );
        allow delete: if isMember()
                      && resource.data.uid == request.auth.uid;
      }

      match /typing/{userId} {
        allow read: if isMember();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
