rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chat messages: readable by any signed-in user (including anonymous
    // guests), creatable only by the authenticated author, and immutable
    // once written.
    match /ChatMessages/{messageId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.name is string
                    && request.resource.data.keys().hasOnly(
                         ['text', 'name', 'uid', 'timestamp']
                       );

      // Messages cannot be edited or deleted (yet). Tighten/loosen in a
      // later phase when edit/delete features land.
      allow update, delete: if false;
    }
  }
}
