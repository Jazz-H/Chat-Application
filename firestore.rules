rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared validation for a chat message create.
    function isValidMessage() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly(
             ['text', 'name', 'uid', 'timestamp']
           );
    }

    // Messages now live under a room/channel:
    // rooms/{roomId}/messages/{messageId}
    // Readable by any signed-in user (including anonymous guests), creatable
    // only by the authenticated author, and immutable once written.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if isValidMessage();

      // Reactions: any signed-in user may change ONLY the `reactions` field.
      // Edit: the author may change ONLY `text` (+ `editedAt`), within limits.
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions'])
        || (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
        )
      );

      // Delete: author only.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Ephemeral "typing" indicators: one doc per user, written only by that
    // user, readable by anyone signed in. Staleness is handled client-side.
    match /rooms/{roomId}/typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy flat collection (pre-rooms). Kept readable and writable during
    // the transition so the previously-deployed app keeps working until the
    // rooms version ships; can be locked down in a later cleanup.
    match /ChatMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if isValidMessage();
      allow update, delete: if false;
    }
  }
}
